# Copy this file to .env and adjust the values as needed.
# ==============================
# Video & Model
# ==============================
VIDEO_PATH=videos/restaurant-demo.mp4
# Public YouTube live pages are resolved at runtime and refreshed after disconnections.
DINING_VIDEO_PATH=https://www.youtube.com/watch?v=-J49AAW3Wik
# Public YouTube live page used as the entrance/passerby camera.
ENTRANCE_VIDEO_PATH=https://www.youtube.com/watch?v=3nyPER2kzqk
MODEL_PATH=models/yolo26n-pose.pt
ROLE_MODEL_PATH=
ROLE_MODEL_CONF=0.45
CALIBRATION_MODEL_PATH=models/yolo26n-seg.pt

# ==============================
# Inference
# ==============================
CONF=0.40
IOU=0.50
IMGSZ=640
DEVICE=cuda:0
REQUIRE_CUDA=true
HALF_PRECISION=true
TARGET_FPS=10.0
INFERENCE_BATCH_SIZE=2
QUEUE_DWELL_SECONDS=3.0
STAFF_MARKER_HSV_LOWER=80,80,60
STAFF_MARKER_HSV_UPPER=110,255,255
STAFF_MARKER_MIN_RATIO=0.025
TABLE_ASSIGNMENT_MARGIN_RATIO=0.012
TABLE_OCCLUSION_HOLD_SECONDS=1.5

# ==============================
# Logged Count Stabilization
# ==============================
COUNT_INCREASE_DELAY=2.0
COUNT_DECREASE_DELAY=10.0
COUNT_EMPTY_DELAY=10.0
COUNT_HISTORY_SIZE=10

# ==============================
# Output Video
# ==============================
SAVE_OUTPUT_VIDEO=False
OUTPUT_VIDEO_PATH=videos/output/restaurant_analysis_output.mp4

# ==============================
# Video Resizing
# ==============================
RESIZE_VIDEO=False
VIDEO_WIDTH=1280

# ==============================
# Display
# ==============================
SHOW_DASHBOARD=true
DASHBOARD_WIDTH=200
